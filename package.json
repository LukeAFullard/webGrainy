{
  "name": "imagegrains-web",
  "version": "0.1.0",
  "description": "100% client-side, privacy-first, offline-first gravel and sediment grain-sizing engine (ImageGrains 2.0 Web)",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:perf": "PERF_STRICT=1 vitest run --no-file-parallelism",
    "test:e2e:browser": "node scripts/smoke-dist.mjs",
    "test:e2e:sw": "node scripts/smoke-sw-update.mjs",
    "tutorials": "node scripts/record-tutorials.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.31.1",
    "utif2": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  }
}
